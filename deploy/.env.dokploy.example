# Paste into the Dokploy Compose service Environment tab; fill every blank.
# APP_ORIGIN is fixed by the release to match the frontend build.
POSTGRES_DB=docs-pipeline
POSTGRES_USER=docs_pipeline
POSTGRES_PASSWORD=
KEYCLOAK_DB=docs-pipeline-keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Optional console domain must be configured separately in Dokploy (minio:9001).
MINIO_CONSOLE_URL=https://minio-dev.example.com
MISTRAL_API_KEY=
HF_EMBEDDING_SERVICE_URL=
# Choose vllm or cerebras and fill the corresponding endpoint/key.
LLM_PROVIDER=vllm
VLLM_AGRINET_MODEL_URL=
CEREBRAS_API_KEY=
